# Cadena de conexión de Supabase (Project Settings → Database → Connection string → Session pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Portal: URL y clave PUBLICABLE del proyecto (nunca service_role ni secret key).
# El usuario configura estos valores en su entorno; DATABASE_URL no se usa en el portal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Asistente del portal: clave privada de Anthropic, solo en el servidor.
ANTHROPIC_API_KEY=
# Modelo opcional; por defecto claude-sonnet-5-5.
CHAT_MODEL=claude-sonnet-5-5
